IVC_BOOT_WATCH_BIN=/usr/local/sbin/ivc_boot_watch
ROOT_GUEST_HEALTH_BIN=/usr/local/sbin/root_guest_health_watch.py
ENABLE_IRQ_WATCH=1
GUEST_LINUX_IRQ=107
GUEST_RTTHREAD_IRQ=109
GUEST_LINUX_ZONE_CFG=/root/SeawayHyper/zone1/zone1-linux.json
GUEST_RTTHREAD_ZONE_CFG=/root/SeawayHyper/zone2/zone2-rtt.json
GUEST_LINUX_ZONE_ID=1
GUEST_RTTHREAD_ZONE_ID=2
# Optional explicit device override. If unset, watcher resolves device path from
# WEB_HVISOR_IVC_DEVICE_MAP*, then falls back to legacy GUEST_*_IVC_ID.
# GUEST_LINUX_DEVICE_PATH=/dev/hivc0
# GUEST_RTTHREAD_DEVICE_PATH=/dev/hivc2
# Legacy fallback only.
GUEST_LINUX_IVC_ID=0
GUEST_RTTHREAD_IVC_ID=2
HVISOR_BIN=/root/SeawayHyper/bin/hvisor
IVC_DEMO_BIN=/usr/local/bin/ivc_monitor
IVC_JSON_PREFIX=IVC_JSON:
POLL_MS=200
STARTUP_TIMEOUT_S=30
REARM_S=0
MONITOR_TIMEOUT_S=0
HEARTBEAT_TIMEOUT_S=15
MIN_SEQ_UPDATES=2
FRESH_UPTIME_SLACK_S=20
REBOOT_UPTIME_ROLLBACK_S=60
RESTART_BACKOFF_S=1
DEVICE_RETRY_S=5
IRQ_FILE_TIMEOUT_S=15
CONSOLE_BOOT_LOG_MODE=always
ROOT_BOOT_STAGE_BOOT_ID_FILE=/run/root_boot_health_watch.boot_id
GUEST_PROGRESS_ENABLE=1
GUEST_PROGRESS_INTERVAL_S=2
GUEST_PROGRESS_TO_CONSOLE=1
GUEST_PROGRESS_TO_JOURNAL=1
GUEST_STAGE_HOOK=/usr/local/sbin/root_guest_stage_hook.sh
GUEST_STAGE_HOOK_TIMEOUT_S=2
GUEST_HEALTH_DEBUG=0
# ROOT_READY_FILE=/run/root-health.ready
